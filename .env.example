# Copy to .env for local overrides. Values here are the defaults used by docker-compose.yml.
# Non-production secrets only: the realm file deploy/keycloak/realm-ue.json uses the same values.

POSTGRES_USER=pcas
POSTGRES_PASSWORD=pcas
POSTGRES_DB=pcas

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

ASPNETCORE_ENVIRONMENT=Development
CLOCK__MODE=Offset
CLOCK__ANCHOR=2026-10-16T18:00:00Z

# Optional (D-138). When set, the reset and scenario routes and every /internal/v1/admin/* route also need the header X-Reset-Secret: <this value>.
# The e2e specs and the golden API test read the same name from their environment. Leave empty for the demo.
RESET_SECRET=

# Client secrets for the service clients in the local realm.
UW_WORKBENCH_CLIENT_SECRET=uw-workbench-local-secret
SVC_PCAS_API_CLIENT_SECRET=svc-pcas-api-local-secret

# Addresses and ports (D-231). The defaults run on this machine at http://localhost:8080. On a server, see deploy/server/README.md.
# PCAS_URL is the address people open; KEYCLOAK_URL is the address of the sign-in service. Both exactly as typed in the browser, with no trailing slash.
#   PCAS_URL=http://localhost:8080
#   KEYCLOAK_URL=http://localhost:8180
# The host ports, and the address they are bound to (127.0.0.1 keeps the stack private to this machine; a proxy on the same machine reaches it there).
#   PCAS_PORT=8080
#   API_PORT=8000
#   KEYCLOAK_PORT=8180
#   MOCKS_PORT=8090
#   DB_PORT=5433
#   BIND_ADDRESS=127.0.0.1
# A different port only: change the port AND the address that uses it, e.g. PCAS_PORT=9080 with PCAS_URL=http://localhost:9080.
# Served under a path prefix behind a proxy (for example https://idea.example.com/ue-pcas/): the proxy removes the prefix before the request reaches the stack.
# Set all three, and rebuild the web, bff and mock-systems images from a build that supports it (D-234):
#   PCAS_URL=https://idea.example.com/ue-pcas      the address people open, prefix included
#   PCAS_ORIGIN=https://idea.example.com           the same address without the prefix (the BFF wants a bare origin)
#   PCAS_BASE_PATH=/ue-pcas                        the prefix alone
# The sign-in service can sit under a path too (for example KEYCLOAK_URL=https://idea.example.com/ue-pcas-keycloak). Then also set its path alone:
#   KEYCLOAK_PATH=/ue-pcas-keycloak                the path part of KEYCLOAK_URL; leave unset when KEYCLOAK_URL has none

# AI provider (D-005, D-220). Replay answers from recorded replies and is the default; verify and the tests always use it.
# To demo a live model, set AI__PROVIDER=OpenAI and put the key in your own .env (git-ignored; never commit it). OpenAI is for the demo. The production provider is not chosen yet: it will be agreed with UE against Q79 (US processing, no training on UE data, providers disclosed); Azure OpenAI was only a suggestion (D-230).
#   AI__PROVIDER=Replay            # Replay | Anthropic | AzureOpenAI | OpenAI
#   OPENAI_API_KEY=                # the key; read by pcas-api, never logged or shown
#   OPENAI_MODEL=gpt-4.1           # the model that answers
#   OPENAI_INPUT_PER_MTOK=2        # dollars per million input tokens, so cost and the monthly cap are metered (set your contract's price)
#   OPENAI_OUTPUT_PER_MTOK=8
# The governance page's default wording holds for any provider. To name the provider there, set for example:
#   AI__CONTROLS__PROVIDER=OpenAI
#   AI__CONTROLS__DATAHANDLING=The text of a notice or a sentence is sent to OpenAI (api.openai.com) to be read. Production will use a provider agreed with UE.
