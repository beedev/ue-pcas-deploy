      "clientId": "pcas-bff",
      "name": "PCAS backend-for-frontend (token handler, D-151)",
      "enabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles (flat)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
